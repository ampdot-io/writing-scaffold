{
  "name": "writing-scaffold",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP resources for the CopypastaText corpus",
  "type": "module",
  "bin": {
    "writing-scaffold": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-html.mjs && node scripts/build-cloudflare.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run bundle && node scripts/test.mjs",
    "config": "node scripts/mcp-config.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "build:cloudflare": "npm run build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.4.0",
    "diff": "9.0.0",
    "llama3-tokenizer-js": "1.2.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.162.0"
  }
}
