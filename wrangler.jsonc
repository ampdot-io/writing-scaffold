{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "writing-scaffold",
  "main": "dist/cloudflare/worker.mjs",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/cloudflare/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "REQUEST_LOGS",
      "bucket_name": "writing-scaffold-requests"
    }
  ],
  "observability": {
    "enabled": true
  }
}
